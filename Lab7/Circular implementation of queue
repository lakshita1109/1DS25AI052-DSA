#include <stdio.h>
#define SIZE 5
int queue[SIZE];
int front=-1,rear=-1;
void enqueue(int x){
    if((rear+1)%SIZE==front){
        printf("queue is full");
        return ;
    }
    if(front==-1) front=0;
    rear=(rear+1)%SIZE;
    queue[rear]=x;
}
int dequeue(){
    if(front==-1){
        printf("queue is empty");
        return -1;
    }
    int val=queue[front];
    if(front==rear){
        front=-1,rear=-1;
    }
    else{
        front=(front+1)%SIZE;
    }
    return val;
}
void display(){
    if(front==-1){
        printf("queue is empty");
        return;
    }
    int i=front;
    while(1){
        printf("%d ",queue[i]);
        if(i==rear) {
           
            break;
        }
        i=(i+1)%SIZE;
    }
}
int main() {
    enqueue(10);
    enqueue(20);
    enqueue(30);
    printf("\nDequeued: %d\n", dequeue());
    enqueue(40);
    enqueue(50);
    display(); 
    enqueue(60);
    display();
    enqueue(70);
    return 0; }


