// Compare Triplets
int* compareTriplets(int a_count, int* a, int b_count, int* b, int* result_count) {
int *result=malloc(2*sizeof(int));
int alice=0;
int bob=0;
for(int i=0;i<3;i++){
    if(a[i]>b[i]){
        alice++;
    }
    else if(b[i]>a[i]){
        bob++;
    }
}
result[0]=alice;
result[1]=bob;
*result_count=2;
return result;
}

