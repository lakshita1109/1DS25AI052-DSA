#include <stdio.h>
void linearsearch(int mat[3][3],int search,int n){
    int cmp=0;
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            cmp++;
            if(mat[i][j]==search){
                printf("key is found :row %d, col: %d\n",i,j);
                printf("no of comparisons %d",cmp);
            }
        }
    }
   
}


void maxmin(int mat[3][3],int n){
    int max=mat[0][0];
    int min=mat[0][0];
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
           
            if(mat[i][j]>max){
               max=mat[i][j];
            }
            if(mat[i][j]<min){
               min=mat[i][j];
            }
        }
    }
    printf("max :%d ,min : %d",max,min);
   
}
void matsum(int mat[3][3],int n){
    int sum=0;
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            sum+=mat[i][j];
        }
    }
    printf("sum:%d",sum);
   
}
void upper(int mat[3][3],int n){
   
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            if(j>=i){
                printf("%d ",mat[i][j]);
            }
        }
        printf("\n");
    }
 
   
}
void rowsum(int mat[3][3],int n){
   
    for(int i=0;i<n;i++){
        int sum=0;
        for(int j=0;j<n;j++){
            sum+=mat[i][j];
        }
        printf("sum ofrow:%d is %d\n",i,sum);
    }
   
   
}
void transpose(int mat[3][3],int n){
   
    for(int i=0;i<n;i++){
        for(int j=i;j<n;j++){
            int temp=mat[i][j];
            mat[i][j]=mat[j][i];
            mat[j][i]=temp;
        }
       
    }
}
void traverse(int mat[3][3],int n){
   
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            printf("%d ",mat[i][j]);
        }
        printf("\n");
    }
}
void colsum(int mat[3][3],int n){
   
    for(int i=0;i<n;i++){
        int sum=0;
        for(int j=0;j<n;j++){
            sum+=mat[j][i];
        }
        printf("sum of col:%d is %d\n",i,sum);
    }
   
   
}
   

int main() {
int mat[3][3]={{1,3,4},{5,6,7},{8,9,10}};
int search=7;
int n=3;
linearsearch(mat,search,n); //1
maxmin(mat,n); //2
printf("\n");
matsum(mat,n); //3
printf("\n");
upper(mat,n); //4
rowsum(mat,n); //5
traverse(mat,n);
transpose(mat,n);//6
traverse(mat,n);
colsum(mat,n); //7




}


