class Solution {
  public:
    int evaluatePostfix(vector<string>& tokens) {
        int a=0,b=0;
                stack<int>st;
                for(int i=0;i<tokens.size();i++){
                    if(tokens[i]=="+"){
                        b=st.top();
                        st.pop();
                        a=st.top();
                        st.pop();
                        st.push(a+b);

                    }
                     else if(tokens[i]=="-"){
                        b=st.top();
                        st.pop();
                        a=st.top();
                        st.pop();
                        st.push(a-b);

                    }
                    else if(tokens[i]=="*"){
                        b=st.top();
                        st.pop();
                        a=st.top();
                        st.pop();
                        st.push(a*b);

                    }
                    else if(tokens[i]=="/"){
                        b=st.top();
                        st.pop();
                        a=st.top();
                        st.pop();
                        st.push(floor((double)a/b));

                    }
                    else if(tokens[i]=="^"){
                        b=st.top();
                        st.pop();
                        a=st.top();
                        st.pop();
                        st.push(pow(a,b));

                    }
                    else{
                        st.push(stoi(tokens[i]));
                    }
                }
                return st.top();
        
    }
};
