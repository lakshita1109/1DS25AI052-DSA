#include <bits/stdc++.h>
using namespace std;
#define MAX 100


int main() {
	stack<int>st;
	
	int a,b,result;
	cout<<"enter expression ";
	string prefix;
	cin>>prefix;
	for(int i=prefix.size()-1;i>=0;i--){
	    if(isdigit(prefix[i])){
	        
	        st.push(prefix[i]-'0');
	    }
	    else{
	        a=st.top();
	        st.pop();
	        b=st.top();
	        st.pop();
	        if(prefix[i]=='+'){
	            result=a+b;
	            st.push(result);
	            
	        }
	        else if (prefix[i]=='-'){
	            result=a-b;
	            st.push(result);
	            
	        }
	        else if(prefix[i]=='*'){
	            result=a*b;
	            st.push(result);
	            
	        }
	    }
	}
	cout<<"Result"<<st.top();
	return 0;

}
